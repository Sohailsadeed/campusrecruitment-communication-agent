# =====================================================================
# SpeakFlow backend settings — copy to backend/.env and fill in.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is git-ignored and holds real secrets. Never commit it, never
# paste its values into an issue, a log or a frontend bundle. The values below
# are placeholders and examples only.
#
# Every name here maps to a field in backend/config.py (case-insensitive);
# list values are JSON, e.g. CORS_ORIGINS=["http://localhost:5173"].
# =====================================================================

# --- Application -----------------------------------------------------
DEBUG=false

# Signing key for SpeakFlow's own login JWTs. Generate one; do not reuse a
# value you have seen anywhere, including this file.
SECRET_KEY=
# Login token lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database / infrastructure --------------------------------------
# Local development uses the containers in docker-compose.services.yml.
DATABASE_URL=postgresql+psycopg2://speakflow:speakflow@localhost:5432/speakflow
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8100

# --- Browser origins -------------------------------------------------
# Which frontends may call this API with credentials. Add the port your dev
# server actually uses; do not widen this to "*" in any environment where the
# API is reachable from the internet.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174"]

# --- Model / LLM providers ------------------------------------------
# Which provider scores answers. Local by default; a key below does NOT select OpenRouter.
# Accepted values: ollama (default) | openrouter
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
WHISPER_MODEL_NAME=base
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- LiveKit (self-hosted WebRTC SFU) --------------------------------
# The key pair comes from .env.livekit (see .env.livekit.example); the id is
# public inside every token, the secret is not — it is the only thing that can
# mint room access, so it stays in the backend's environment.
# Generate a pair:
#   docker run --rm --entrypoint /livekit-server livekit/livekit-server:v1.13.11 generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The URL the browser dials. Local development talks straight to the container;
# a deployment uses the TLS terminus and must be wss:// — browsers refuse
# microphone access on a non-secure origin, so wss:// is not optional in
# production.
LIVEKIT_URL=ws://localhost:7880

# Room token lifetime in minutes (1-1440) and the prefix every SpeakFlow room
# starts with, so rooms are namespaced per deployment.
LIVEKIT_TOKEN_TTL_MINUTES=15
LIVEKIT_ROOM_PREFIX=speakflow
