# =====================================================================
# Copy to .env.livekit (git-ignored) and fill in before starting the SFU:
#   cp .env.livekit.example .env.livekit
#
# Generate a real key pair with the server image itself — SpeakFlow does not
# ship, embed or reuse a published secret anywhere:
#   docker run --rm --entrypoint /livekit-server livekit/livekit-server:v1.13.11 generate-keys
# =====================================================================

# Key id: not a secret (it travels inside every token the browser receives),
# but it must match what the server was given, and it must not be "devkey"
# once this leaves a laptop.
LIVEKIT_API_KEY=

# Secret: the only thing that can sign a room token. Never commit it, never
# send it to the frontend, never log it. Rotate by replacing the value and
# restarting the container.
LIVEKIT_API_SECRET=

# Address the browser can reach for WebRTC. 127.0.0.1 is correct when the SFU
# runs in Docker Desktop and the browser runs on the same machine. On a hosted
# server, leave this empty so LiveKit advertises its own interface, and point
# the backend's LIVEKIT_URL (backend/.env) at the public wss:// endpoint instead.
LIVEKIT_NODE_IP=127.0.0.1
